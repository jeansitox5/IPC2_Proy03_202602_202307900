@page
@model ReporteModel
@{
    ViewData["Title"] = "Reporte de autorizaciones";
}

<h1>Reporte de autorizaciones</h1>
<p class="text-muted">Facturas recibidas por el servicio y sus errores, agrupadas por fecha de emisión.</p>

<form method="get" class="card card-body mb-4">
    <div class="row g-3 align-items-end">
        <div class="col-md-3">
            <label asp-for="Desde" class="form-label fw-semibold">Desde</label>
            <input asp-for="Desde" type="date" class="form-control" />
        </div>
        <div class="col-md-3">
            <label asp-for="Hasta" class="form-label fw-semibold">Hasta</label>
            <input asp-for="Hasta" type="date" class="form-control" />
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100">Consultar</button>
        </div>
    </div>
</form>

@if (Model.Error != null)
{
    <div class="alert alert-danger">@Model.Error</div>
}

@if (Model.Resultado != null)
{
    <div class="mb-3">
        <a class="btn btn-outline-danger" asp-page-handler="Pdf"
           asp-route-Desde="@Model.Desde?.ToString("yyyy-MM-dd")" asp-route-Hasta="@Model.Hasta?.ToString("yyyy-MM-dd")">
            Descargar PDF
        </a>
    </div>

    @if (Model.Resultado.Fechas.Count == 0)
    {
        <p class="text-muted">No se recibieron facturas en ese rango.</p>
    }

    @* Una tarjeta por fecha, con la misma estructura del reporte del enunciado *@
    @foreach (ReporteFecha fecha in Model.Resultado.Fechas)
    {
        <div class="card mb-3" style="max-width: 720px;">
            <div class="card-header fw-bold">FECHA: @fecha.Fecha.ToString("dd/MM/yyyy")</div>
            <div class="card-body p-0">
                <table class="table table-sm mb-0">
                    <tbody>
                        <tr class="table-light fw-semibold">
                            <td>Cantidad total de facturas recibidas</td>
                            <td class="text-end">@fecha.TotalRecibidas</td>
                        </tr>
                        <tr><td colspan="2" class="fw-semibold">Listado de errores en facturas recibidas</td></tr>
                        <tr><td class="ps-4">NIT emisor inválido</td><td class="text-end">@fecha.NitEmisorInvalido</td></tr>
                        <tr><td class="ps-4">NIT receptor inválido</td><td class="text-end">@fecha.NitReceptorInvalido</td></tr>
                        <tr><td class="ps-4">NIT emisor inexistente</td><td class="text-end">@fecha.NitEmisorInexistente</td></tr>
                        <tr><td class="ps-4">NIT receptor inexistente</td><td class="text-end">@fecha.NitReceptorInexistente</td></tr>
                        <tr><td class="ps-4">IVA mal calculado</td><td class="text-end">@fecha.IvaMalCalculado</td></tr>
                        <tr><td class="ps-4">TOTAL mal calculado</td><td class="text-end">@fecha.TotalMalCalculado</td></tr>
                        <tr><td class="ps-4">REFERENCIA duplicada</td><td class="text-end">@fecha.ReferenciaDuplicada</td></tr>
                        <tr><td class="ps-4">Formato inválido (datos mal formados)</td><td class="text-end">@fecha.FormatoInvalido</td></tr>
                        <tr class="table-light fw-semibold">
                            <td>Cantidad de facturas sin errores</td>
                            <td class="text-end">@fecha.SinErrores</td>
                        </tr>
                        <tr><td>Cantidad de emisores de facturas</td><td class="text-end">@fecha.CantidadEmisores</td></tr>
                        <tr><td>Cantidad de receptores de facturas</td><td class="text-end">@fecha.CantidadReceptores</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    }
}