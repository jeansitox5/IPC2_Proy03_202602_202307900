@page
@model ContribuyenteModel
@{
    ViewData["Title"] = "Consultar contribuyente";
}

<h1>Consultar contribuyente</h1>
<p class="text-muted">Facturas autorizadas emitidas o recibidas por un contribuyente en un rango de fechas.</p>

@* ---------------------------------------------------------------- Filtros (formulario GET) *@
<form method="get" class="card card-body mb-4">
    <div class="row g-3 align-items-end">
        <div class="col-md-4">
            <label asp-for="Nit" class="form-label fw-semibold">Contribuyente</label>
            <select asp-for="Nit" class="form-select">
                <option value="">-- Seleccione un NIT --</option>
                @foreach (ContribuyenteSalida contribuyente in Model.Contribuyentes)
                {
                    <option value="@contribuyente.Nit">@contribuyente.Nit — @contribuyente.Nombre</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <span class="form-label fw-semibold d-block">Facturas</span>
            <div class="form-check">
                <input class="form-check-input" type="radio" asp-for="Tipo" value="emitidas" id="tipoEmitidas" />
                <label class="form-check-label" for="tipoEmitidas">Emitidas</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="radio" asp-for="Tipo" value="recibidas" id="tipoRecibidas" />
                <label class="form-check-label" for="tipoRecibidas">Recibidas</label>
            </div>
        </div>
        <div class="col-md-2">
            <label asp-for="Desde" class="form-label fw-semibold">Desde</label>
            <input asp-for="Desde" type="date" class="form-control" />
        </div>
        <div class="col-md-2">
            <label asp-for="Hasta" class="form-label fw-semibold">Hasta</label>
            <input asp-for="Hasta" type="date" class="form-control" />
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100">Consultar</button>
        </div>
    </div>
</form>

@if (Model.Error != null)
{
    <div class="alert alert-danger">@Model.Error</div>
}

@* ---------------------------------------------------------------- Resultado *@
@if (Model.Resultado != null)
{
    ConsultaContribuyenteRespuesta r = Model.Resultado;

    <h2 class="h4">
        @r.Nit — @r.Nombre
        <small class="text-muted">· facturas @r.Tipo del @r.Desde.ToString("dd/MM/yyyy") al @r.Hasta.ToString("dd/MM/yyyy")</small>
    </h2>

    @if (r.Fechas.Count == 0)
    {
        <p class="text-muted">No hay facturas autorizadas en ese rango.</p>
    }
    else
    {
        <h3 class="h5 mt-3">Resumen por fecha</h3>
        <table class="table table-striped table-sm w-auto">
            <thead>
                <tr>
                    <th>Fecha</th>
                    <th class="text-end">Facturas autorizadas</th>
                    <th class="text-end">Monto facturado (Q)</th>
                </tr>
            </thead>
            <tbody>
                @foreach (TotalPorFecha fila in r.Fechas)
                {
                    <tr>
                        <td>@fila.Fecha.ToString("dd/MM/yyyy")</td>
                        <td class="text-end">@fila.Cantidad</td>
                        <td class="text-end">@fila.Monto.ToString("N2")</td>
                    </tr>
                }
            </tbody>
            <tfoot class="fw-bold">
                <tr>
                    <td>Total del rango</td>
                    <td class="text-end">@r.CantidadTotal</td>
                    <td class="text-end">@r.MontoTotal.ToString("N2")</td>
                </tr>
            </tfoot>
        </table>

        <h3 class="h5 mt-4">Listado de facturas</h3>
        <table class="table table-striped table-sm">
            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Referencia</th>
                    <th>Código de aprobación</th>
                    <th>NIT emisor</th>
                    <th>NIT receptor</th>
                    <th class="text-end">Valor</th>
                    <th class="text-end">IVA</th>
                    <th class="text-end">Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (FacturaResumen factura in r.Facturas)
                {
                    <tr>
                        <td>@factura.FechaEmision.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@factura.Referencia</td>
                        <td><code>@factura.CodigoAprobacion</code></td>
                        <td>@factura.NitEmisor</td>
                        <td>@factura.NitReceptor</td>
                        <td class="text-end">@factura.Valor.ToString("N2")</td>
                        <td class="text-end">@factura.Iva.ToString("N2")</td>
                        <td class="text-end">@factura.Total.ToString("N2")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
}
